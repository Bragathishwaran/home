{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/home", "dest": "/index.html" },
    { "src": "/home2", "dest": "/home2.html" },
    { "src": "/about", "dest": "/pages/about.html" },
    { "src": "/contact", "dest": "/pages/contact.html" },
    { "src": "/products", "dest": "/pages/products.html" },
    { "src": "/pricing", "dest": "/pages/pricing.html" },
    { "src": "/installation", "dest": "/pages/installation-process.html" },
    { "src": "/solutions", "dest": "/pages/solutions.html" },
    { "src": "/login", "dest": "/pages/login.html" },
    { "src": "/register", "dest": "/pages/register.html" },
    { "src": "/forgot-password", "dest": "/pages/forgot-password.html" },
    { "src": "/legal", "dest": "/pages/legal.html" },
    { "src": "/dashboard", "dest": "/pages/dashboard/index.html" },
    { "src": "/dashboard/(.*)", "dest": "/pages/dashboard/$1.html" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}